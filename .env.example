CHATBOT_APP_TITLE=ChatBot Đại Học Hoa Sen
CHATBOT_MODE=gui
CHATBOT_KNOWLEDGE_FILE=knowledge.txt

CHATBOT_VECTOR_MAX_DF=0.95
CHATBOT_VECTOR_MIN_DF=1
CHATBOT_VECTOR_MAX_FEATURES=3000

CHATBOT_RETRIEVAL_K=5
CHATBOT_EXPLANATION_TOP_K=3
CHATBOT_SIMILARITY_THRESHOLD=0.18
CHATBOT_FALLBACK_MESSAGE=I don't know that yet. Please try rephrasing your question or update knowledge.txt.

CHATBOT_SHOW_EXPLANATIONS=true
CHATBOT_HOT_RELOAD=true

CHATBOT_HISTORY_EXPORT_DIR=exports
CHATBOT_HISTORY_KEEP_LAST_EXPORTS=20

# Opt in: enabling this may crawl the configured website on first startup.
CHATBOT_WEB_ENABLED=false
CHATBOT_WEB_SEED_URLS=https://www.hoasen.edu.vn
CHATBOT_WEB_ALLOWED_DOMAINS=hoasen.edu.vn
CHATBOT_WEB_MAX_PAGES=60
CHATBOT_WEB_TIMEOUT_SECONDS=12
CHATBOT_WEB_INDEX_DIR=web_index
CHATBOT_WEB_TOP_K=3

CHATBOT_DEBUG=false
CHATBOT_LOG_LEVEL=INFO
